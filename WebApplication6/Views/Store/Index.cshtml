@model WebApplication6.Models.StoreHomeViewModel

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<!-- ===== HERO BANNER ===== -->
<section class="hero">
    <div>
        <p>NEW SEASON / SPORT & ACTIVE</p>
        <h1>Move better. Train stronger.</h1>
        <p>Khám phá bộ sưu tập thể thao dành cho tập luyện, thi đấu và phong cách sống năng động.</p>
        <a class="btn-brand" href="#featured-products">Mua sắm ngay</a>
    </div>
</section>

<h2 class="section-title">Tất cả sản phẩm</h2>

<!-- ===== KHUNG CHÍNH: danh mục trái + sản phẩm phải ===== -->
<div class="store-shell" id="featured-products">
    <aside class="category-panel">
        <h3>Danh mục</h3>
        <div class="catalog-toolbar">
            @using (Html.BeginForm(
                "Index",
                "Store",
                FormMethod.Get,
                new { @class = "catalog-search" }))
            {
                @* Nếu đang lọc Category thì giữ categoryId khi tìm kiếm. *@
                if (Model.SelectedCategoryId.HasValue)
                {
                    <input type="hidden"
                           name="categoryId"
                           value="@Model.SelectedCategoryId" />
                }

                <input type="text"
                       name="keyword"
                       value="@Model.SearchTerm"
                       placeholder="Tìm tên hoặc mô tả sản phẩm..." />

                <button type="submit" class="btn-brand">
                    Tìm kiếm
                </button>

                <a class="btn-soft"
                   href="@Url.Action("Index", "Store")">
                    Xóa lọc
                </a>
            }
        </div>

        <ul class="category-list">
            @foreach (var category in Model.Categories)
            {
                <li>
                    <a href="@Url.Action(
                        "Index",
                        "Store",
                        new
                        {
                            categoryId = category.CategoryID,
                            keyword = Model.SearchTerm
                        })">
                        @category.CategoryName
                    </a>
                </li>
            }
        </ul>
    </aside>

    <section>
        @* ===== DANH SÁCH SẢN PHẨM ===== *@
        @* Kiểm tra danh sách Products có sản phẩm hay không *@
        @if (Model.Products.Any())
        {
            @* Có sản phẩm → hiển thị danh sách sản phẩm *@
            <div class="product-grid">

                @foreach (var item in Model.Products)
                {
                    <article class="product-card">

                        <div class="product-image">
                            @* Hiển thị ảnh sản phẩm từ Content/images *@
                            <img src="~/Content/images/@item.ImagePro"
                                 alt="@item.NamePro" />
                        </div>

                        <div class="product-body">
                            <div style="color:#64748b;font-size:13px;">
                                @item.CategoryName
                            </div>

                            <div class="product-name">
                                @item.NamePro
                            </div>

                            <div class="product-description">
                                @item.ShortDescription
                            </div>

                            <div class="product-price">
                                @item.Price.ToString("#,##0") đ
                            </div>

                            <div class="product-actions">
                                <a class="btn-soft" href="#">Chi tiết</a>
                                <a class="btn-brand" href="#">Mua</a>
                            </div>
                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="catalog-empty">
                <h3>Không tìm thấy sản phẩm phù hợp</h3>
                <p>
                    Không có sản phẩm nào phù hợp với các điều kiện lọc hoặc từ khóa đang chọn.
                </p>
                <a class="btn-brand" href="@Url.Action("Index", "Store")">
                    Xem tất cả sản phẩm
                </a>
            </div>
        }
    </section>
</div>