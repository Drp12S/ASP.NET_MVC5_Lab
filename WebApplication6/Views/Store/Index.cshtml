@model WebApplication6.Models.StoreHomeViewModel

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<!-- ===== HERO BANNER ===== -->
<section class="hero">
    <div>
        <p>NEW SEASON / SPORT & ACTIVE</p>
        <h1>Move better. Train stronger.</h1>
        <p>Khám phá bộ sưu tập thể thao dành cho tập luyện, thi đấu và phong cách sống năng động.</p>
        <a class="btn-brand" href="#featured-products">Mua sắm ngay</a>
    </div>
</section>

<h2 class="section-title">Tất cả sản phẩm</h2>

<!-- ===== KHUNG CHÍNH: danh mục trái + sản phẩm phải ===== -->
<div class="store-shell" id="featured-products">
    <aside class="category-panel">
        <h3>Danh mục</h3>
        <div class="catalog-toolbar">
            @using (Html.BeginForm("Index", "Store",
                FormMethod.Get,
                new { @class = "catalog-search" }))
            {
                @* Nếu đang lọc Category thì giữ categoryId khi tìm kiếm. *@
                if (Model.SelectedCategoryId.HasValue)
                {
                    <input type="hidden"
                           name="categoryId"
                           value="@Model.SelectedCategoryId" />
                }

                <input type="text"
                       name="keyword"
                       value="@Model.SearchTerm"
                       placeholder="Tìm tên hoặc mô tả sản phẩm..." />

                @* Giá tối thiểu; có thể để trống *@
                <input type="number"
                       name="minPrice"
                       value="@Model.MinPrice"
                       min="0"
                       step="1000"
                       placeholder="Giá từ" />

                @* Giá tối đa; có thể để trống *@
                <input type="number"
                       name="maxPrice"
                       value="@Model.MaxPrice"
                       min="0"
                       step="1000"
                       placeholder="Giá đến" />

                <select name="sortOrder" onchange="this.form.submit()">
                    <option value="">Sắp xếp mặc định</option>
                    <option value="price_asc" @(Model.SortOrder == "price_asc" ? "selected" : "")>Giá thấp → cao</option>
                    <option value="price_desc" @(Model.SortOrder == "price_desc" ? "selected" : "")>Giá cao → thấp</option>
                </select>

                <button type="submit" class="btn-brand">
                    Tìm kiếm
                </button>

                <a class="btn-soft" href="@Url.Action("Index", "Store")">
                    Xóa lọc
                </a>
            }
        </div>

        <ul class="category-list">
            @foreach (var category in Model.Categories)
            {
                <li class="@(category.CategoryID == Model.SelectedCategoryId ? "active" : "")">
                    <a class="@(category.CategoryID == Model.SelectedCategoryId ? "active" : "")"
                       href="@Url.Action(
                        "Index",
                        "Store",
                        new
                        {
                            categoryId = category.CategoryID,
                            keyword = Model.SearchTerm,
                            minPrice = Model.MinPrice,
                            maxPrice = Model.MaxPrice,
                            sortOrder = Model.SortOrder
                        })">
                        @category.CategoryName
                    </a>
                </li>
            }
        </ul>
    </aside>

    <section>
        <p style="margin-bottom: 16px; font-weight: 600; color: #334155;">
            Tìm thấy @Model.TotalItems sản phẩm
        </p>

        @* ===== DANH SÁCH SẢN PHẨM ===== *@
        @* Kiểm tra danh sách Products có sản phẩm hay không *@
        @if (Model.Products.Any())
        {
            @* Có sản phẩm → hiển thị danh sách sản phẩm *@
            <div class="product-grid">

                @foreach (var item in Model.Products)
                {
                    <article class="product-card">

                        <div class="product-image">
                            @* Hiển thị ảnh sản phẩm từ Content/images *@
                            <img src="~/Content/images/@item.ImagePro"
                                 alt="@item.NamePro" />
                        </div>

                        <div class="product-body">
                            <div style="color:#64748b;font-size:13px;">
                                @item.CategoryName
                            </div>

                            <div class="product-name">
                                @item.NamePro
                            </div>

                            <div class="product-description">
                                @item.ShortDescription
                            </div>

                            <div class="product-price">
                                @item.Price.ToString("#,##0") đ
                            </div>

                            <div class="product-actions">
                                @* B07 mới thực hiện chức năng Giỏ hàng *@
                                @if (item.StockQuantity > 0)
                                {
                                    @Html.ActionLink(
                                        "Mua",
                                        "AddToCart",
                                        "ShoppingCart",
                                        new { id = item.ProductID },
                                        new { @class = "btn-brand" }
                                    )
                                }
                                else
                                {
                                    <span class="btn-soft" style="background:#e2e8f0;color:#94a3b8;cursor:not-allowed;">Hết hàng</span>
                                }
                            </div>
                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="catalog-empty">
                <h3>Không tìm thấy sản phẩm phù hợp</h3>
                <p>
                    Không có sản phẩm nào phù hợp với các điều kiện lọc hoặc từ khóa đang chọn.
                </p>
                <a class="btn-brand" href="@Url.Action("Index", "Store")">
                    Xem tất cả sản phẩm
                </a>
            </div>
        }

        @* ==================== PHÂN TRANG ==================== *@
        @if (Model.TotalPages > 1)
        {
            <div class="store-pagination">

                @* Nút quay về trang trước *@
                @if (Model.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", "Store", new
                        {
                            categoryId = Model.SelectedCategoryId,
                            keyword = Model.SearchTerm,
                            minPrice = Model.MinPrice,
                            maxPrice = Model.MaxPrice,
                            sortOrder = Model.SortOrder,
                            page = Model.CurrentPage - 1
                        })">
                        ← Trước
                    </a>
                }

                @* Hiển thị các số trang *@
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.CurrentPage)
                    {
                        @* Trang hiện tại không cần tạo link *@
                        <span class="active">@i</span>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "Store", new
                            {
                                categoryId = Model.SelectedCategoryId,
                                keyword = Model.SearchTerm,
                                minPrice = Model.MinPrice,
                                maxPrice = Model.MaxPrice,
                                sortOrder = Model.SortOrder,
                                page = i
                            })">
                            @i
                        </a>
                    }
                }

                @* Nút sang trang kế tiếp *@
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="@Url.Action("Index", "Store", new
                        {
                            categoryId = Model.SelectedCategoryId,
                            keyword = Model.SearchTerm,
                            minPrice = Model.MinPrice,
                            maxPrice = Model.MaxPrice,
                            sortOrder = Model.SortOrder,
                            page = Model.CurrentPage + 1
                        })">
                        Sau →
                    </a>
                }

            </div>
        }
    </section>
</div>